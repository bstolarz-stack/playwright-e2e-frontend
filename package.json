{
  "name": "frontend-tests",
  "version": "1.0.0",
  "description": "Playwright tests for sportsbet.com.ar - China Charm automation",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:daily": "npx tsx scripts/daily-casino-agent.ts",
    "test:heal": "npx tsx scripts/healer-agent.ts",
    "ticket-to-tests": "npx tsx scripts/ticket-to-tests-agent.ts",
    "smoke": "npx playwright test tests/tucanwin/login.spec.ts --reporter=allure",
    "report": "npx allure generate allure-results --clean && npx allure open"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "allure": "^3.8.2",
    "allure-playwright": "^3.8.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.59.1"
  }
}
